{
  "name": "fitsense-ai-backend",
  "version": "1.0.0",
  "description": "FitSense AI / FlexSense - Smart Rehabilitation & Joint Motion Analytics Backend API (Render Cloud & Local Serial Bridge)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "render-build": "npm install --no-optional || npm install",
    "bridge": "node scripts/local-serial-bridge.js"
  },
  "keywords": [
    "fitsense",
    "flexsense",
    "rehabilitation",
    "mpu6050",
    "esp32",
    "express",
    "typescript",
    "render"
  ],
  "author": "Nithesh P, Koushik G, Sujay S (Team HackElite / Team Razers)",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ws": "^8.17.0"
  },
  "optionalDependencies": {
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/ws": "^8.5.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
